# Ajustes opcionales del servicio y del recolector.
LA_PALA_SOURCES_FILE=scraping/sources.json
LA_PALA_CATALOG_FILE=data/catalogo.json
LA_PALA_DATA_DIR=data
LA_PALA_LOG_DIR=logs
LA_PALA_HOST=127.0.0.1
PORT=8000
LA_PALA_DELAY_SECONDS=8
LA_PALA_TIMEOUT_SECONDS=12
LA_PALA_MAX_PAGES=12
LA_PALA_OPEN_BROWSER=1
# LA_PALA_USER_AGENT=LaPalaBot/2.0 contacto@tu-dominio.bo
# Motor HTTP: httpuv (ligero, por defecto) o plumber.
# LA_PALA_MOTOR=httpuv
# Clave administrativa del entorno MAPACHE; no guardes aquí una clave real.
# MAPACHE_ACCESS_PASSWORD=
# Motores de búsqueda opcionales. Configura credenciales reales en el entorno privado.
# BRAVE_SEARCH_KEY=
# BING_SEARCH_KEY=
# GOOGLE_CSE_KEY=
# GOOGLE_CSE_CX=
